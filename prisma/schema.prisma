datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

enum Role {
  STUDENT
  COACH
}

model User {
  id            String    @id @default(cuid())
  name          String?
  isNameSet     Boolean   @default(false)
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STUDENT)
  // Curriculum level a coach placed the child at (levels before it count as passed); null = start at the beginning.
  startLevel    String?
  lichessId     String?   @unique
  
  // Ratings
  ratingPuzzle         Int?
  ratingBullet         Int?
  ratingBlitz          Int?
  ratingRapid          Int?
  ratingClassical      Int?
  ratingCorrespondence Int?
  puzzleRd             Float     @default(350)
  puzzleVolatility     Float     @default(0.06)
  
  accounts      Account[]
  sessions      Session[]
  
  createdPuzzles Puzzle[]
  createdOpenings Opening[]
  createdPractices Practice[]
  
  // Student progress tracking
  practiceProgress  PracticeLineProgress[]
  openingProgress   OpeningProgress[]
  gameRecords       GameRecord[]
  puzzleAttempts    PuzzleAttempt[]
  practiceAttempts  PracticeAttempt[]
  tagStats          UserTagStats[]

  // Coach homework
  assignmentsCreated  Assignment[] @relation("AssignmentCoach")
  assignmentsReceived Assignment[] @relation("AssignmentStudent")

  // Fun modes (streaks, races, bots, mini-games, level tests)
  playSessions        PlaySession[]
  racesHosted         PuzzleRace[]
  raceEntries         PuzzleRaceEntry[]
  league              LeagueMembership?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Puzzle {
  id          String   @id @default(cuid())
  name        String   @unique
  fen         String
  solution    String
  description String?
  rating      Int      @default(1200)
  ratingDeviation Float    @default(350)
  volatility      Float    @default(0.06)
  tags        String[]
  hints       Json?    // Array of strings, one per move index
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  attempts    PuzzleAttempt[]
}

model PuzzleAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId  String
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  success   Boolean
  points    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([puzzleId])
}

model UserTagStats {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag           String
  totalCount    Int      @default(0)
  unsolvedCount Int      @default(0)

  @@unique([userId, tag])
  @@index([userId])
}

model Opening {
  id          String   @id @default(cuid())
  name        String
  pgn         String
  description String?
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  steps       OpeningStep[]
  progress    OpeningProgress[]
}

model OpeningStep {
  id          String   @id @default(cuid())
  openingId   String
  opening     Opening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
  fen         String
  arrows      String?  // JSON string of arrows e.g. "[['e2', 'e4', 'green']]"
  description String?
  order       Int
}

enum PlayerColor {
  WHITE
  BLACK
}

model Practice {
  id          String      @id @default(cuid())
  name        String
  description String?
  playerColor PlayerColor @default(WHITE)  // Which side the student plays
  createdBy   String
  creator     User        @relation(fields: [createdBy], references: [id])
  createdAt   DateTime    @default(now())
  nodes       PracticeNode[]
  progress    PracticeLineProgress[]
  attempts    PracticeAttempt[]
  assignments Assignment[]
}

model PracticeNode {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  parentId    String?  // null for root node
  parent      PracticeNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    PracticeNode[] @relation("NodeTree")
  fen         String   // Position AFTER this move is made
  move        String?  // UCI move string (e.g. "e2e4"), null for root node
  notes       String?  // Coach notes for this move/position
  order       Int      @default(0)  // For ordering siblings
  lineNumber  Int?     // For ordering lines in practice (only set on leaf nodes)
  progress    PracticeLineProgress[]
  attempts    PracticeAttempt[]
  question    PracticeQuestion?
}

// ============================================
// STUDENT PROGRESS TRACKING
// ============================================

enum LineStatus {
  PERFECT      // Completed without any wrong moves
  COMPLETED    // Completed but made some wrong moves
  PARTIAL      // Started but didn't complete
  NEVER_SEEN   // Never attempted this line
}

// Tracks student progress on each practice line (leaf node)
model PracticeLineProgress {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceId String
  practice   Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  nodeId     String     // ID of the leaf node
  node       PracticeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  status     LineStatus @default(NEVER_SEEN)
  attempts   Int        @default(0)
  perfectCount  Int        @default(0)  // Number of times completed perfectly
  lastAttemptAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, practiceId, nodeId])
}

model PracticeAttempt {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceId String
  practice   Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  nodeId     String
  node       PracticeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  status     LineStatus
  mistakes   Int        @default(0)     // Wrong moves in this attempt (recorded since the student profile was added)
  usedHints  Boolean    @default(false) // Coach notes or arrows were shown during this attempt
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([practiceId])
}

// Tracks which openings a student has studied (viewed)
model OpeningProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openingId   String
  opening     Opening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
  viewCount   Int      @default(0)
  lastViewedAt DateTime?
  completed   Boolean  @default(false)  // Viewed all steps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, openingId])
}

// Records of games played (for later review)
model GameRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lichessGameId String   // The Lichess game ID
  opponentId    String?  // Lichess ID of opponent (if known)
  opponentName  String?  // Name of opponent
  playerColor   PlayerColor
  result        String?  // "win", "loss", "draw"
  openingName   String?  // Opening name if detected
  playedAt      DateTime @default(now())
  
  @@index([userId])
  @@index([lichessGameId])
}

enum AssignmentKind {
  PRACTICE      // Complete `target` different lines of a practice
  PUZZLE_THEME  // Try `target` puzzles with a theme tag
  LEVEL         // Pass the test of the curriculum level in `tag` (target is always 1)
}

// Homework a coach sets for one student, or for every student when studentId is null.
model Assignment {
  id         String         @id @default(cuid())
  coachId    String
  coach      User           @relation("AssignmentCoach", fields: [coachId], references: [id], onDelete: Cascade)
  studentId  String?
  student    User?          @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  kind       AssignmentKind
  practiceId String?
  practice   Practice?      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  tag        String?
  target     Int
  note       String?
  dueOn      DateTime       @db.Date  // Last Sofia calendar day to finish it
  createdAt  DateTime       @default(now())

  @@index([studentId])
  @@index([dueOn])
}

// Lichess accounts left out of the leaderboards (e.g. coaches' or test accounts). Edited on /leaderboard/settings.
// "Show again" sets hidden to false instead of deleting the row, so an empty table always means "never set up"
// and the original list is filled in automatically (see src/lib/leaderboardExclusions.ts).
model LeaderboardExclusion {
  lichessId String   @id
  hidden    Boolean  @default(true)
  addedBy   String?  // Lichess id of whoever last changed it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlayKind {
  STREAK
  COORDINATES
  DUEL
  RACE
  MINIGAME
  BOT_GAME
  LEVEL_TEST
  LEVEL_PRACTICE
  TOURNAMENT
}

// One finished fun activity. Fun modes never touch the puzzle rating; personal bests, bot wins,
// mini-game stars and level passes are all read from here.
model PlaySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      PlayKind
  key       String   @default("")  // e.g. bot id, mini-game level id, race id, level id
  score     Int      @default(0)
  won       Boolean?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@index([kind, createdAt])
}

enum RaceMode {
  RACE  // Coach-hosted club race shown on a projector
  DUEL  // Two children, started by either of them
}

// A puzzle race or duel. Everyone gets the same puzzles in the same order; the race is unrated.
// The phase (waiting / countdown / running / finished) follows from startsAt and endsAt.
model PuzzleRace {
  id          String            @id @default(cuid())
  code        String            // 4 digits, typed by children to join; reused after a race finishes
  hostId      String
  host        User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  mode        RaceMode
  puzzleIds   String[]
  durationSec Int
  startsAt    DateTime?
  endsAt      DateTime?
  recorded    Boolean           @default(false) // Play sessions written for every racer
  nextRaceId  String?           // Rematch
  createdAt   DateTime          @default(now())
  entries     PuzzleRaceEntry[]

  @@index([code, createdAt])
}

model PuzzleRaceEntry {
  raceId    String
  race      PuzzleRace @relation(fields: [raceId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nextIndex Int        @default(0)
  score     Int        @default(0)
  solved    Int        @default(0)
  combo     Int        @default(0)
  bonuses   Int        @default(0)
  skipped   Boolean    @default(false)
  joinedAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@id([raceId, userId])
}

// An optional "why?" question a coach attaches to the last move of an opening line; asked after the line is played.
model PracticeQuestion {
  nodeId      String       @id
  node        PracticeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  prompt      String
  options     String[]
  answer      Int          // index into options
  explanation String?
  updatedBy   String?
  updatedAt   DateTime     @updatedAt
}

enum LeagueTier {
  WOOD
  STONE
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

// A child's league tier. Children without a row are in WOOD. Tiers only go up.
model LeagueMembership {
  userId    String     @id
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      LeagueTier @default(WOOD)
  updatedAt DateTime   @updatedAt
}

// Marks a finished week as processed (promotions applied), so it happens exactly once.
model LeagueWeek {
  weekStart   String   @id // Sofia Monday, "YYYY-MM-DD"
  promoted    Int      @default(0)
  processedAt DateTime @default(now())
}

enum TournamentKind {
  ARENA
  SWISS
}

// A Lichess arena or Swiss tournament a coach pasted for the club. Results are read from Lichess once it ends.
model ClubTournament {
  id         String         @id @default(cuid())
  kind       TournamentKind
  lichessId  String
  name       String
  startsAt   DateTime
  finishesAt DateTime?
  finished   Boolean        @default(false)
  // Club members' results once finished: [{ lichessId, rank, score }]
  results    Json?
  createdBy  String
  createdAt  DateTime       @default(now())

  @@unique([kind, lichessId])
  @@index([startsAt])
}
